<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="14.0" prefHeight="320.0" prefWidth="460.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.CheckoutGameController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Checkout Board Game">
            <font>
                <Font name="Georgia" size="22.0" />
            </font>
        </Label>
        <Label text="Select Available Game:" />
        <ComboBox fx:id="availableGamesComboBox" prefWidth="380.0" promptText="Choose a game..." />
        <Label text="Select Registered Customer:" />
        <ComboBox fx:id="customersComboBox" prefWidth="380.0" promptText="Choose a patron..." />
        <Button mnemonicParsing="false" onAction="#onCheckoutButtonClicked" text="Complete Checkout" />
        <Label fx:id="checkoutStatusLabel" wrapText="true" textFill="#1b5e20" />
    </children>
</VBox>
