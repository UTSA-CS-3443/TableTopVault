<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.LoginScreenController">

   <children>
      <BorderPane fx:id="loginBorderPane" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

         <top>
            <ToolBar prefHeight="104.0" prefWidth="700.0">
               <items>
                  <Label prefHeight="42.0" prefWidth="509.0" text="TableTop Vault">
                     <font>
                        <Font name="Georgia" size="36.0" />
                     </font>
                     <padding>
                        <Insets left="10.0" right="10.0" />
                     </padding>
                  </Label>

                  <VBox prefHeight="101.0" prefWidth="203.0" spacing="5.0">
                     <children>
                        <TextField fx:id="usernameTextField" prefHeight="25.0" prefWidth="157.0" promptText="1234">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin></TextField>

                        <PasswordField fx:id="passwordTextField" promptText="1234">
                           <VBox.margin>
                              <Insets left="10.0" />
                           </VBox.margin></PasswordField>

                        <Button fx:id="loginButton" onAction="#onLoginButtonClick" text="Staff Login">
                           <VBox.margin>
                              <Insets left="65.0" />
                           </VBox.margin></Button>

                        <Label fx:id="loginIndicatorLabel" textFill="red" />
                     </children>
                  </VBox>
               </items>
            </ToolBar>
         </top>

         <center>
            <AnchorPane prefHeight="395.0" prefWidth="400.0" />
         </center>

      </BorderPane>
   </children>
</AnchorPane>
