<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" prefHeight="320.0" prefWidth="480.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.FindGamesController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Find a Board Game">
            <font>
                <Font name="Georgia" size="22.0" />
            </font>
        </Label>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="gameNameTextField" prefWidth="300.0" promptText="Enter game title (e.g., Catan)" />
                <Button mnemonicParsing="false" onAction="#onFindButtonClicked" text="Search" />
            </children>
        </HBox>
        <Label fx:id="searchResultLabel" wrapText="true" prefHeight="160.0" prefWidth="420.0" />
    </children>
</VBox>
