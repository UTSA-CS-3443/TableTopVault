<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450.0" prefWidth="815.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.ListCustomersController">

    <children>
        <TableView fx:id="customersTableView" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <columns>
                <TableColumn fx:id="fullNameColumn" prefWidth="122.00000250339508" text="Full Name" />
                <TableColumn fx:id="emailColumn" prefWidth="108.66661834716797" text="Email" />
                <TableColumn fx:id="phoneNumberColumn" prefWidth="108.00001525878906" text="Phone Number" />
                <TableColumn fx:id="preferredContactColumn" minWidth="0.0" prefWidth="98.6666259765625" text="Pref. Contact" />
                <TableColumn fx:id="customerNotesColumn" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="375.0000305175781" text="Customer Notes" />
            </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>

        </TableView>
    </children>
</AnchorPane>
