<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="340.0" prefWidth="480.0" spacing="15.0" style="-fx-background-color: #243e5b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.FindCustomersController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Find a Customer" textFill="WHITE">
            <font>
                <Font name="Georgia" size="22.0" />
            </font>
        </Label>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="customerNameTextField" prefWidth="300.0" promptText="Enter customer full name (e.g., Bob Ross)">
               <font>
                  <Font name="Verdana" size="12.0" />
               </font></TextField>
                <Button mnemonicParsing="false" onAction="#onFindCustomerButtonClicked" style="-fx-background-color: #f5a802;" text="Search">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font></Button>
            </children>
        </HBox>
        <Label fx:id="searchResultLabel" prefHeight="180.0" prefWidth="420.0" textFill="#fbf5f5" wrapText="true">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
    </children>
</VBox>
