<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="420.0" prefWidth="560.0" spacing="12.0" style="-fx-background-color: #243e5b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.CheckinGameController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Return / Check-In Game" textFill="#f4eeee">
            <font>
                <Font name="Georgia Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Select Active Rental to Return:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <ComboBox fx:id="activeRentalsComboBox" prefWidth="480.0" promptText="Choose an active checkout..." style="-fx-background-color: #f5a802;" />
        <Button mnemonicParsing="false" onAction="#onReturnGameButtonClicked" style="-fx-background-color: #f5a802;" text="Process Return">
         <font>
            <Font name="Verdana Bold" size="12.0" />
         </font></Button>
        <Label fx:id="checkinStatusLabel" textFill="WHITE" wrapText="true">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <Label text="All Rental Records:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <ListView fx:id="rentalHistoryListView" prefHeight="170.0" prefWidth="500.0" />
    </children>
</VBox>
