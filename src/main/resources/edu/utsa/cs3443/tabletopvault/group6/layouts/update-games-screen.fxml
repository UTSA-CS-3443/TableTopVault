<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" prefHeight="440.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.UpdateGamesController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Existing Game">
            <font>
                <Font name="Georgia" size="22.0" />
            </font>
        </Label>
        <Label text="Search Game Title:" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="titleTextField" prefWidth="320.0" promptText="Enter game title to load..." />
                <Button mnemonicParsing="false" onAction="#onLoadGameButtonClicked" text="Load Game" />
            </children>
        </HBox>
        <HBox spacing="15.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Min Players:" />
                        <TextField fx:id="minPlayersTextField" prefWidth="100.0" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Max Players:" />
                        <TextField fx:id="maxPlayersTextField" prefWidth="100.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label text="Category:" />
        <TextField fx:id="categoryTextField" />
        <CheckBox fx:id="availableCheckBox" mnemonicParsing="false" selected="true" text="Available on Shelf" />
        <Label text="Game Notes:" />
        <TextArea fx:id="notesTextArea" prefHeight="65.0" />
        <Button mnemonicParsing="false" onAction="#onUpdateGameButtonClicked" text="Update Game" />
        <Label fx:id="statusLabel" textFill="#1b5e20" />
    </children>
</VBox>
