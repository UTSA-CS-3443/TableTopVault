<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="440.0" prefWidth="520.0" spacing="10.0" style="-fx-background-color: #243e5b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.UpdateGamesController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Existing Game" textFill="WHITE">
            <font>
                <Font name="Georgia Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Search Game Title:" textFill="#fffafa">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="titleTextField" prefWidth="320.0" promptText="Enter game title to load..." />
                <Button mnemonicParsing="false" onAction="#onLoadGameButtonClicked" style="-fx-background-color: #f5a802;" text="Load Game">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font></Button>
            </children>
        </HBox>
        <HBox spacing="15.0">
            <children>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Min Players:" textFill="WHITE">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></Label>
                        <TextField fx:id="minPlayersTextField" prefWidth="100.0" />
                    </children>
                </VBox>
                <VBox spacing="5.0">
                    <children>
                        <Label text="Max Players:" textFill="WHITE">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></Label>
                        <TextField fx:id="maxPlayersTextField" prefWidth="100.0" />
                    </children>
                </VBox>
            </children>
        </HBox>
        <Label text="Category:" textFill="#fbf9f9">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextField fx:id="categoryTextField" />
        <CheckBox fx:id="availableCheckBox" mnemonicParsing="false" selected="true" text="Available on Shelf" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></CheckBox>
        <Label text="Game Notes:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextArea fx:id="notesTextArea" prefHeight="65.0" />
        <Button mnemonicParsing="false" onAction="#onUpdateGameButtonClicked" style="-fx-background-color: #f5a802;" text="Update Game">
         <font>
            <Font name="Verdana Bold" size="12.0" />
         </font></Button>
        <Label fx:id="statusLabel" textFill="#1b5e20" />
    </children>
</VBox>
