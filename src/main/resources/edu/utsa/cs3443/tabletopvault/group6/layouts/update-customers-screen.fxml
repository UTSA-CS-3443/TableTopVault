<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="430.0" prefWidth="520.0" spacing="10.0" style="-fx-background-color: #243e5b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.UpdateCustomersController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Customer Profile" textFill="#f6f5f5">
            <font>
                <Font name="Georgia Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Customer Full Name:" textFill="#fbf5f5">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="fullNameTextField" prefWidth="310.0" promptText="Enter full name to load..." />
                <Button mnemonicParsing="false" onAction="#onLoadCustomerButtonClicked" style="-fx-background-color: #f5a802;" text="Load Profile">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font></Button>
            </children>
        </HBox>
        <Label text="Email:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextField fx:id="emailTextField" />
        <Label text="Phone Number:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextField fx:id="phoneNumberTextField" />
        <Label text="Preferred Contact (Email / Text / Phone):" textFill="#f6f5f5">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextField fx:id="preferredContactTextField" />
        <Label text="Customer Notes:" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
        <TextArea fx:id="customerNotesTextArea" prefHeight="65.0" />
        <Button mnemonicParsing="false" onAction="#onUpdateCustomerButtonClicked" style="-fx-background-color: #f5a802;" text="Save Changes">
         <font>
            <Font name="Verdana Bold" size="12.0" />
         </font></Button>
        <Label fx:id="statusLabel" textFill="#1b5e20" />
    </children>
</VBox>
