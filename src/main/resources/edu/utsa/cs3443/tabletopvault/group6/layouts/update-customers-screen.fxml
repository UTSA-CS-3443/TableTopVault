<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" prefHeight="430.0" prefWidth="520.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.UpdateCustomersController">
    <padding>
        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
    </padding>
    <children>
        <Label text="Update Customer Profile">
            <font>
                <Font name="Georgia" size="22.0" />
            </font>
        </Label>
        <Label text="Customer Full Name:" />
        <HBox spacing="10.0">
            <children>
                <TextField fx:id="fullNameTextField" prefWidth="310.0" promptText="Enter full name to load..." />
                <Button mnemonicParsing="false" onAction="#onLoadCustomerButtonClicked" text="Load Profile" />
            </children>
        </HBox>
        <Label text="Email:" />
        <TextField fx:id="emailTextField" />
        <Label text="Phone Number:" />
        <TextField fx:id="phoneNumberTextField" />
        <Label text="Preferred Contact (Email / Text / Phone):" />
        <TextField fx:id="preferredContactTextField" />
        <Label text="Customer Notes:" />
        <TextArea fx:id="customerNotesTextArea" prefHeight="65.0" />
        <Button mnemonicParsing="false" onAction="#onUpdateCustomerButtonClicked" text="Save Changes" />
        <Label fx:id="statusLabel" textFill="#1b5e20" />
    </children>
</VBox>
