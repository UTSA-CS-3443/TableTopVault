<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="420.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.AddNewCustomersController">
   <children>
      <Label layoutX="22.0" layoutY="14.0" prefHeight="39.0" prefWidth="250.0" text="New Customer">
         <font>
            <Font name="Georgia" size="25.0" />
         </font>
      </Label>
      <Label layoutX="21.0" layoutY="70.0" text="Full Name" />
      <TextField fx:id="fullNameTextField" layoutX="21.0" layoutY="90.0" prefHeight="26.0" prefWidth="297.0" />
      <Label layoutX="21.0" layoutY="125.0" text="Email" />
      <TextField fx:id="emailTextField" layoutX="21.0" layoutY="145.0" prefWidth="150.0" />
      <Label layoutX="184.0" layoutY="125.0" text="Phone Number" />
      <TextField fx:id="phoneNumberTextField" layoutX="184.0" layoutY="145.0" prefWidth="135.0" />
      <MenuButton layoutX="21.0" layoutY="190.0" mnemonicParsing="false" text="Preferred Contact">
        <items>
          <MenuItem mnemonicParsing="false">
               <graphic>
                  <CheckBox fx:id="emailCheckBox" selected="true" mnemonicParsing="false" text="Email" />
               </graphic>
            </MenuItem>
          <MenuItem mnemonicParsing="false">
               <graphic>
                  <CheckBox fx:id="textCheckBox" mnemonicParsing="false" text="Text" />
               </graphic>
            </MenuItem>
        </items>
      </MenuButton>
      <Label layoutX="21.0" layoutY="235.0" text="Customer Notes" />
      <TextArea fx:id="customerNotesTextArea" layoutX="21.0" layoutY="255.0" prefHeight="105.0" prefWidth="300.0" />
      <Label layoutX="355.0" layoutY="125.0" text="Games Checked Out" />
      <TextArea fx:id="gamesCheckedoutTextArea" layoutX="355.0" layoutY="145.0" prefHeight="168.0" prefWidth="220.0" />
      <Button fx:id="onAddCustomerClicked" layoutX="420.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleAddCustomer" text="Add Customer" />
      <Label fx:id="statusLabel" layoutX="21.0" layoutY="375.0" prefWidth="550.0" textFill="#1b5e20" />
   </children>
</AnchorPane>
