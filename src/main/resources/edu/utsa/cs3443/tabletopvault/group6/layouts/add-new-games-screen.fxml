<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="420.0" prefWidth="500.0" spacing="10.0" style="-fx-background-color: #243e5b;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.AddNewGamesController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label text="Add New Game" textFill="#fffafa">
         <font>
            <Font name="Georgia Bold" size="22.0" />
         </font>
      </Label>
      <Label text="Game Title:" textFill="#fcf9f9">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
      <TextField fx:id="titleTextField" promptText="e.g., Terraforming Mars">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></TextField>
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Min Players:" textFill="#f7f1f1">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></Label>
                  <TextField fx:id="minPlayersTextField" prefWidth="100.0" promptText="1">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></TextField>
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Max Players:" textFill="#f7f4f4">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></Label>
                  <TextField fx:id="maxPlayersTextField" prefWidth="100.0" promptText="5">
                     <font>
                        <Font name="Verdana" size="12.0" />
                     </font></TextField>
               </children>
            </VBox>
         </children>
      </HBox>
      <Label text="Category:" textFill="WHITE" />
      <TextField fx:id="categoryTextField" promptText="e.g., Strategy, Party, Cooperative">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></TextField>
      <Label text="Condition / Game Notes:" textFill="#f7f3f3">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
      <TextArea fx:id="notesTextArea" prefHeight="70.0" promptText="No comment">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></TextArea>
      <HBox spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAddGameButtonClicked" style="-fx-background-color: #f5a802;" text="Save Game">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font></Button>
            <Button mnemonicParsing="false" onAction="#onClearButtonClicked" style="-fx-background-color: #f5a802;" text="Clear">
               <font>
                  <Font name="Verdana Bold" size="12.0" />
               </font></Button>
         </children>
      </HBox>
      <Label fx:id="statusLabel" textFill="WHITE">
         <font>
            <Font name="Verdana" size="12.0" />
         </font></Label>
   </children>
</VBox>
