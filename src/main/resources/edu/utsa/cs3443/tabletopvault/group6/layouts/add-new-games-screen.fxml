<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" prefHeight="420.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.tabletopvault.group6.controller.AddNewGamesController">
   <padding>
      <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
   </padding>
   <children>
      <Label text="Add New Game">
         <font>
            <Font name="Georgia" size="22.0" />
         </font>
      </Label>
      <Label text="Game Title:" />
      <TextField fx:id="titleTextField" promptText="e.g., Terraforming Mars" />
      <HBox spacing="15.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Min Players:" />
                  <TextField fx:id="minPlayersTextField" prefWidth="100.0" promptText="1" />
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label text="Max Players:" />
                  <TextField fx:id="maxPlayersTextField" prefWidth="100.0" promptText="5" />
               </children>
            </VBox>
         </children>
      </HBox>
      <Label text="Category:" />
      <TextField fx:id="categoryTextField" promptText="e.g., Strategy, Party, Cooperative" />
      <Label text="Condition / Game Notes:" />
      <TextArea fx:id="notesTextArea" prefHeight="70.0" promptText="No comment" />
      <HBox spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onAddGameButtonClicked" text="Save Game" />
            <Button mnemonicParsing="false" onAction="#onClearButtonClicked" text="Clear" />
         </children>
      </HBox>
      <Label fx:id="statusLabel" textFill="#1b5e20" />
   </children>
</VBox>
